OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=8010
ENVIRONMENT=local
LOG_LEVEL=INFO
MAX_INPUT_CHARS=12000
MAX_PASSES=3
SCORE_THRESHOLD=85
REQUEST_TIMEOUT_SECONDS=120
MAX_TOKENS_PER_REQUEST=8000

# Start with a no-cost rehearsal. Set live for actual OpenAI calls.
APP_MODE=demo
ENABLE_DEMO_SCENARIOS=true
# Optional shared token protecting /humanize (enter it in the UI).
CLASS_ACCESS_TOKEN=

# Sign in at smith.langchain.com, then Settings > API Keys.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deployments-observability
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
# Use fictional classroom text. true hides payloads but keeps timings/structure.
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
